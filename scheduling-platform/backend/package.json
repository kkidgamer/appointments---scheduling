{
  "name": "scheduling-platform-backend",
  "version": "1.0.0",
  "description": "Multi-tenant appointment scheduling platform backend",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:make": "knex migrate:make",
    "test": "node node_modules/jest/bin/jest.js --forceExit --detectOpenHandles",
    "test:unit": "node node_modules/jest/bin/jest.js --testPathPattern=unit --forceExit",
    "test:integration": "node node_modules/jest/bin/jest.js --testPathPattern=integration --forceExit --detectOpenHandles"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "pg": "^8.13.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "better-sqlite3": "^13.0.3",
    "jest": "^29.7.0",
    "supertest": "^6.3.4"
  }
}
